# Contoh konfigurasi environment — salin menjadi .env lalu isi nilai aslinya
# cp .env.example .env  (Windows: copy .env.example .env)

NODE_ENV=development
PORT=5000

# WhatsApp admin (tanpa +, contoh: 6285126246175)
WHATSAPP_NUMBER=6285126246175

# Chatbot Eva (Gemini) — WAJIB diisi di lokal & di Vercel Dashboard
# Ambil dari https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Supabase — WAJIB agar data booking persisten (lokal + Vercel)
# Dashboard: https://supabase.com/dashboard/project/kyxqufvwvofdaohqlknf/settings/api
SUPABASE_URL=https://kyxqufvwvofdaohqlknf.supabase.co
# Isi salah satu: service_role (backend, paling aman) atau publishable/anon
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Jalankan supabase.sql di SQL Editor untuk membuat tabel bookings

# Kunci admin sederhana untuk melindungi GET/PUT/DELETE booking + /api/stats
# Isi dengan string acak panjang, samakan di Vercel. Kosongkan = tanpa proteksi (mode lama).
ADMIN_KEY=

# Grup WA admin untuk notifikasi booking & bukti transfer (Fonnte)
# ID grup diawali angka dan diakhiri @g.us
WA_GROUP_ID=

# Rekening pembayaran (dipakai template closing Eva di WhatsApp)
BCA_NUMBER=203-123-5415
BCA_HOLDER=Lilis Riawaningsih
DANA_NUMBER=0831-9558-5892
DANA_HOLDER=Septian Gilang
# DP minimal layanan panggilan/home service (rupiah, angka saja)
DP_MINIMAL=50000

# Bank (tampil di invoice / konfirmasi, opsional)
BANK_NAME=BCA
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=Home Spa Family

# Eva AI WhatsApp auto-reply (Fonnte) — WAJIB diisi di lokal & Vercel
# Token device dari https://web.fonnte.com (Device -> lihat token)
FONNTE_TOKEN=
# Webhook URL di Fonnte Dashboard (Device -> Edit -> Webhook URL):
#   https://www.homespafamily.my.id/api/wa-webhook
# Wajib: aktifkan "auto read" pada device, nonaktifkan autoreply bawaan Fonnte.
