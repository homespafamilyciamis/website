# Contoh konfigurasi environment — salin menjadi .env lalu isi nilai aslinya
# cp .env.example .env  (Windows: copy .env.example .env)

NODE_ENV=development
PORT=5000

# WhatsApp admin (tanpa +, contoh: 6283195585892)
WHATSAPP_NUMBER=6283195585892

# Chatbot Santi (Gemini) — WAJIB diisi di lokal & di Vercel Dashboard
# Ambil dari https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Supabase — WAJIB agar data booking persisten (lokal + Vercel)
# Dashboard: https://supabase.com/dashboard/project/kyxqufvwvofdaohqlknf/settings/api
SUPABASE_URL=https://kyxqufvwvofdaohqlknf.supabase.co
# Isi salah satu: service_role (backend, paling aman) atau publishable/anon
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Jalankan supabase.sql di SQL Editor untuk membuat tabel bookings

# Kunci admin sederhana untuk melindungi GET/PUT/DELETE booking + /api/stats
# Isi dengan string acak panjang, samakan di Vercel. Kosongkan = tanpa proteksi (mode lama).
ADMIN_KEY=

# Bank (tampil di invoice / konfirmasi, opsional)
BANK_NAME=BCA
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=Home Spa Family
